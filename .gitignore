/target
# L'executable reste dehors : il se reconstruit et pese dix megaoctets a
# chaque version.
/dist
/recherche/*/target

# LaTeX : les residus de compilation, jamais le .tex ni le .pdf
/article/*.aux
/article/*.log
/article/*.out
/article/*.toc
/article/*.fls
/article/*.fdb_latexmk
/article/*.synctex.gz

# Python : les caches de bytecode des outils
__pycache__/

# Les copies de travail locales. Chacune est une copie entiere du depot :
# les commiter ferait entrer le depot dans lui-meme.
/.claude/
